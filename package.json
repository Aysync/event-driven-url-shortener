{
  "name": "event-driven-url-shortener",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run bundle && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'module'}, null, 2))\"",
    "bundle": "esbuild src/handlers/create.ts src/handlers/redirect.ts src/handlers/worker.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist/handlers --external:@aws-sdk/*",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:up": "docker compose -f local/docker-compose.yml up -d",
    "local:down": "docker compose -f local/docker-compose.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
